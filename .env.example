# PantryPal Environment Configuration Example
# Copy this file to .env and fill in your values

# ===================================
# Database (PostgreSQL)
# ===================================
DB_PASSWORD=pantrypal_secure_password_change_me

# ===================================
# Backup Configuration
# ===================================
# Set to true to enable automated backups (PostgreSQL + local storage files)
DB_BACKUP_ENABLED=false
# Cron schedule — default: daily at 2 AM
DB_BACKUP_SCHEDULE=0 2 * * *
# Number of days to keep backups before auto-cleanup
DB_BACKUP_RETENTION_DAYS=7
# Set to true to run a backup immediately when the backup container starts
BACKUP_ON_START=false

# ===================================
# Local File Storage
# ===================================
# Recipe, product, and user images are stored on disk under this path
# (mounted via ./data:/app/data in docker-compose.yml — usually no need to change)
LOCAL_STORAGE_PATH=/app/data/storage

# ===================================
# Security
# ===================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-minimum-32-characters-long

# ===================================
# Recipe Integration
# ===================================
ENABLE_RECIPE_INTEGRATION=true

# ===================================
# Email/SMTP Configuration
# ===================================
# Required for password reset functionality
# Use Gmail App Password (not your regular password)
# Guide: https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=PantryPal
SMTP_USE_TLS=true

# ===================================
# Other SMTP Providers (Examples)
# ===================================

# Outlook/Office365:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@outlook.com
# SMTP_PASSWORD=your-password

# Yahoo:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@yahoo.com
# SMTP_PASSWORD=your-app-password

# Custom SMTP Server:
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password

# ===================================
# Application URL Configuration
# ===================================
# Base URL for email links (password reset, email verification)
# IMPORTANT: Must match exactly how users access your service (including port!)
#
# Common configurations:
#   Production with domain:     APP_URL=https://pantrypal.palstack.io
#   Production with IP:         APP_URL=http://192.168.1.100:8080
#   Local development (Vite):   APP_URL=http://localhost:5173
#   Local docker (nginx):       APP_URL=http://localhost:8888
#
# Port guide:
#   - nginx in docker-compose exposes on port 8888 by default (see ports: "8888:80")
#   - If you change the exposed port to 8080, use that port in APP_URL
#   - If using reverse proxy (Caddy/Nginx) on standard ports, omit the port
#
# If not set, will use the incoming request URL (unreliable for emails)

APP_URL=http://localhost:8888

# ===================================
# Google Sign-In (Optional)
# ===================================
# Native token verification — the client obtains an ID token directly from
# Google's SDK on-device/in-browser and this server verifies it against
# Google's published JWKS. There is no redirect flow and no client secret.
# Leave blank to disable; the "Sign in with Google" button won't render.
#
# Setup:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add your app's origin (e.g. https://pantrypal.yourdomain.com) under
#    "Authorized JavaScript origins"
# 4. Copy the Client ID below
GOOGLE_CLIENT_ID=

# ===================================
# Generic OIDC / SSO (Optional)
# ===================================
# Authorization-code redirect flow for self-hosted identity providers —
# Authentik, Keycloak, Authelia, Okta, Azure AD, or any OIDC-compliant IdP.
# Independent of Google Sign-In above; both can be enabled at once.
# Disabled by default.
OIDC_ENABLED=false

# Display name shown on the login button ("Sign in with <name>")
OIDC_PROVIDER_NAME=SSO

# Client credentials from your IdP
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Discovery URL (preferred — configures everything else automatically)
# Examples:
#   Keycloak:  https://your-keycloak.example.com/realms/{realm}/.well-known/openid-configuration
#   Authentik: https://your-authentik.example.com/application/o/{app-slug}/.well-known/openid-configuration
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration
#   Okta:      https://{your-domain}.okta.com/.well-known/openid-configuration
OIDC_DISCOVERY_URL=

# Manual endpoints — only needed if your provider doesn't support discovery
# (ignored when OIDC_DISCOVERY_URL is set)
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=

OIDC_SCOPES=openid profile email

# Auto-link an OIDC login to an existing account by verified email
OIDC_AUTO_LINK=true

# Auto-create a new account on first OIDC login (if no existing account matches)
# If false, users must be created by an admin before they can sign in via OIDC
OIDC_AUTO_CREATE=true

# Redirect URI to register with your IdP — must be exactly:
#   {APP_URL}/api/auth/oidc/callback
